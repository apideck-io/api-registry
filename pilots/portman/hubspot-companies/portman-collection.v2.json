g\",\"format\":\"uri\"}}}}}}}\n\n// Validate if response matches JSON schema \npm.test(\"[GET]::/crm/v3/objects/companies - Schema is valid\", function() {\n    pm.response.to.have.jsonSchema(schema,{unknownFormats: [\"int32\", \"int64\", \"float\", \"double\"]});\n});\n",

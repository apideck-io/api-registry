[
 "basePath: \"/2.0\"",
 "definitions.api_key.description: \"API Keys can be used as Basic HTTP Authentication credentials and provide a substitute for the account's actual username and password. API Keys are only available to team accounts and there is only 1 key per account. API Keys do not support scopes and have therefore access to all contents of the account.\"",
 "definitions.api_key.in: \"header\"",
 "definitions.api_key.name: \"Authorization\"",
 "definitions.api_key.type: \"apiKey\"",
 "definitions.basic.description: \"Basic HTTP Authentication as per [RFC-2617](https://tools.ietf.org/html/rfc2617) (Digest not supported). Note that Basic Auth is available only with username and app password as credentials.\"",
 "definitions.basic.type: \"basic\"",
 "definitions.oauth2.authorizationUrl: \"https://bitbucket.org/site/oauth2/authorize\"",
 "definitions.oauth2.description: \"OAuth 2 as per [RFC-6749](https://tools.ietf.org/html/rfc6749).\"",
 "definitions.oauth2.flow: \"accessCode\"",
 "definitions.oauth2.scopes.[\"account:write\"]: \"Read and modify your account information\"",
 "definitions.oauth2.scopes.[\"issue:write\"]: \"Read and modify your repositories' issues\"",
 "definitions.oauth2.scopes.[\"pipeline:variable\"]: \"Access your repositories' build pipelines and configure their variables\"",
 "definitions.oauth2.scopes.[\"pipeline:write\"]: \"Access and rerun your repositories' build pipelines\"",
 "definitions.oauth2.scopes.[\"project:admin\"]: \"Read and modify settings for projects in your workspace\"",
 "definitions.oauth2.scopes.[\"pullrequest:write\"]: \"Read and modify your repositories and their pull requests\"",
 "definitions.oauth2.scopes.[\"repository:admin\"]: \"Administer your repositories\"",

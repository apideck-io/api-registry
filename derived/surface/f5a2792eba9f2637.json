 "schemes.apiToken.type: \"apiKey\"",
 "schemes.oauth2.description: \"OAuth2 authentication (authorization code flow). Used when a user delegates permissions to a third-party app. Requires prior OAuth client registration (client ID/secret); the required scopes are specified per operation in `security`. Use exactly one method; it is not combined with token/password authentication.\"",
 "schemes.oauth2.flows.authorizationCode.authorizationUrl: \"https://{subdomain}.cybozu.com/oauth2/authorization\"",

 "schemes.BearerAuth.description: \"OAuth 2.0 access token, presented as a JWT bearer token in the `Authorization` header. Obtain a token via the authorization-code flow; the scopes granted to the token determine which operations it may call.\"",
 "schemes.BearerAuth.flows.authorizationCode.authorizationUrl: \"https://auth.fanvue.com/oauth2/auth\"",
 "schemes.BearerAuth.flows.authorizationCode.refreshUrl: \"https://auth.fanvue.com/oauth2/token\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:agency\"]: \"Read agency information, including the agency's team members.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:chat\"]: \"Read chat conversations, messages, and chat-related data. This includes viewing chat lists and message history.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:creator\"]: \"Access creator profiles, content, and creator-specific information.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:experience\"]: \"Exchange a fan's experience token for the resolved experience and the fan's identity, so an embedded fan-facing experience can render the right content.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:fan\"]: \"Access fan-related data and information within the platform.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:insights\"]: \"Access analytics, metrics, and insights data for performance tracking.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:media\"]: \"Access media files, images, videos, and other content assets.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:post\"]: \"Read posts, including post details, comments, likes, and tips.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:self\"]: \"Access your own user profile information, including basic account details and settings.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"read:tracking_links\"]: \"Read tracking links and the users associated with them, including per-user tracking metadata.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:agency\"]: \"Manage agency team members and invites, including inviting new team members and creators.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:chat\"]: \"Create new chats and send messages. This scope is required for any chat-related actions that modify data.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:creator\"]: \"Modify creator profiles, settings, and creator-specific data.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:experience\"]: \"Request that the creator publish or unpublish a fan-facing experience. The app mints a request token; the creator confirms and Fanvue performs the change.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:media\"]: \"Upload, modify, and manage media files and content assets. Also required for vault folder management.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:post\"]: \"Create, edit, and manage posts and content on behalf of users.\"",
 "schemes.BearerAuth.flows.authorizationCode.scopes.[\"write:tracking_links\"]: \"Create and delete tracking links.\"",

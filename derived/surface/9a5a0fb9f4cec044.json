 "schemes.apiToken.description: \"Preferred authentication method for automation and integrations. Send the API token in the HTTP `Authorization` header.\\n\\n**Format**:\\n  `Authorization: Token {apitoken}`\\n\\n**Notes**:\\n* An API token generated for a specific admin has the same privileges as that admin\\n* An API token is automatically removed if it is not used for more than 90 days\\n* SSO admins cannot generate admin API tokens. Use organization API tokens when scoped Org/Site privileges are needed.\"",
 "schemes.apiToken.in: \"header\"",
 "schemes.apiToken.name: \"Authorization\"",
 "schemes.apiToken.type: \"apiKey\"",
 "schemes.csrfToken.description: \"Session-based authentication for browser or login/password flows. After a successful [Login](/#operations/login) request, Mist returns a `csrftoken` cookie. Send that value in the `X-CSRFToken` header on later API requests that use the login session.\\n\\n**Format**:\\n```\\nX-CSRFToken: vwvBuq9qkqaKh7lu8tNc0gkvBfEaLAmx\\n```\\n\\nFor automation, API Token authentication is preferred.\"",
 "schemes.csrfToken.in: \"header\"",
 "schemes.csrfToken.name: \"X-CSRFToken\"",
 "schemes.csrfToken.type: \"apiKey\"",
 "schemes.oauth2.description: \"OAuth2 authorization code flow (RFC 6749) with PKCE (RFC 7636) and rotating refresh tokens, for third-party applications (including MCP integrations) acting on behalf of a consenting user. It uses an Org API token with `oauth_enabled` set as the OAuth2 client, the `client_id` is its composite `oauth_client_id` (`<org_id>.<token_id>`). See the [Orgs OAuth2](/#operations/getOauthAuthorization) endpoints.\\n\\n**Format**:\\n  `Authorization: Bearer {access_token}`\\n\\n**Notes**:\\n* The access token carries the privileges configured on the API token, constrained to what the consenting user has\\n* The access token expires after `oauth_ttl` (default 1 hour), use the refresh token to get a new one\\n* No fixed scopes are defined, the scope is derived from the API token name (e.g. `custom-ServiceNow Integration`)\"",
 "schemes.oauth2.flows.authorizationCode.authorizationUrl: \"/api/v1/orgs/oauth/authorize\"",
 "schemes.oauth2.flows.authorizationCode.refreshUrl: \"/api/v1/orgs/oauth/token\"",
 "schemes.oauth2.flows.authorizationCode.scopes: {}",
 "schemes.oauth2.flows.authorizationCode.tokenUrl: \"/api/v1/orgs/oauth/token\"",
 "schemes.oauth2.type: \"oauth2\"",
 "security[]: {\"apiToken\":[]}",
 "security[]: {\"csrfToken\":[]}",
 "security[]: {\"oauth2\":[]}",

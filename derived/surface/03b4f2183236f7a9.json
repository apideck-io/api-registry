 "schemes.OAuth2.flows.authorizationCode.scopes.[\"calls:write\"]: \"Create and update calls\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"conversations:read\"]: \"View your Nooks conversations, transcripts and AI recaps\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"credits:read\"]: \"View the workspace's enrichment credit balance\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"email-templates:read\"]: \"View your email templates\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"emails:read\"]: \"View your emails\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"emails:write\"]: \"Create and update emails\"",
 "schemes.OAuth2.flows.authorizationCode.scopes.[\"enrichments:read\"]: \"Estimate enrichment runs and read their status and results\"",

 "schemes.BearerAuth.description: \"Bearer token sent in the `Authorization` header. Accepts either a\\nlong-lived Nooks API key (`nooks-api-...`, from the API Keys page in\\nDeveloper Settings) or an OAuth 2.0 access token issued by\\n`https://oauth.nooks.in`. Use whichever you already have. The API\\nvalidates both formats on the same header. For full OAuth flow\\ndetails (authorize/token endpoints, scopes, refresh behavior) see\\nthe Authentication section of this spec's introduction.\\n\"",
 "schemes.BearerAuth.scheme: \"bearer\"",
 "schemes.BearerAuth.type: \"http\"",
 "schemes.OAuth2.description: \"OAuth 2.0 access token issued by `https://oauth.nooks.in` through the\\nauthorization-code + PKCE flow. Each operation lists the scope it\\nrequires; API keys (`BearerAuth`) are not scope-limited. Server\\nmetadata (RFC 8414):\\n`https://oauth.nooks.in/.well-known/oauth-authorization-server`.\\n\"",
 "schemes.OAuth2.flows.authorizationCode.authorizationUrl: \"https://oauth.nooks.in/oauth/authorize\"",
 "schemes.OAuth2.flows.authorizationCode.refreshUrl: \"https://oauth.nooks.in/oauth/token\"",

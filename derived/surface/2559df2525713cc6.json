 "schemes.advancedAccessToken.description: \"Authenticates API requests with configurable permissions. Can access\\norganization-level resources and optionally scope to a specific payment\\nprofile (`access_...`). Use for advanced integrations — such as bookkeeping\\nor reporting tools — that need fine-grained control over API access.\\n\\nTokens are shown only once, at creation. Store it securely — it cannot be\\nretrieved afterwards. If lost, create a new token under Developers → API\\naccess tokens in the Dashboard and revoke the old one.\"",
 "schemes.advancedAccessToken.scheme: \"bearer\"",
 "schemes.advancedAccessToken.type: \"http\"",
 "schemes.advancedAccessToken.x-default: \"access_dHar4XY7LxsDOtmnkVtjNVWXLSlXsM\"",
 "schemes.apiKey.description: \"Authenticates API requests for a single website profile. Each key targets\\neither live mode (`live_...`) or test mode (`test_...`).\\n\\nKeys are shown only once, at creation. Store the key securely — it cannot\\nbe retrieved afterwards. If lost, create a new key under Developers → API\\naccess tokens in the Dashboard and revoke the old one.\"",
 "schemes.apiKey.scheme: \"bearer\"",
 "schemes.apiKey.type: \"http\"",
 "schemes.apiKey.x-default: \"live_dHar4XY7LxsDOtmnkVtjNVWXLSlXsM\"",
 "schemes.basicAuth.description: \"Authenticates requests using HTTP Basic Authentication. Encode the credentials as\\n`\\\"Basic \\\" + toBase64(username + \\\":\\\" + password)` and pass the result in the `Authorization` header.\"",
 "schemes.basicAuth.scheme: \"basic\"",
 "schemes.basicAuth.type: \"http\"",
 "schemes.oAuth.flows.authorizationCode.authorizationUrl: \"https://my.mollie.com/oauth2/authorize\"",
 "schemes.oAuth.flows.authorizationCode.scopes: {}",
 "schemes.oAuth.flows.authorizationCode.tokenUrl: \"https://api.mollie.com/oauth2/tokens\"",
 "schemes.oAuth.type: \"oauth2\"",
 "security[]: {\"advancedAccessToken\":[]}",
 "security[]: {\"apiKey\":[]}",
 "security[]: {\"oAuth\":[]}",
 "servers[0]: {\"url\":\"https://api.mollie.com\"}"

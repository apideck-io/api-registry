[
 "basePath: \"/\"",
 "definitions.runscope_auth.authorizationUrl: \"https://www.runscope.com/signin/oauth/authorize\"",
 "definitions.runscope_auth.flow: \"accessCode\"",
 "definitions.runscope_auth.scopes.[\"account:email\"]: \"Allows you to read the email addresses of user accounts.\"",
 "definitions.runscope_auth.scopes.[\"api:read\"]: \"Default read access.\"",
 "definitions.runscope_auth.scopes.[\"bucket:auth_token\"]: \"Allows you to read all bucket information, including Authenticated Buckets.\"",
 "definitions.runscope_auth.scopes.[\"bucket:write\"]: \"Allows you to create new buckets on behalf of the user (up to their plan limit).\"",
 "definitions.runscope_auth.scopes.[\"message:write\"]: \"Allows you to create new messages on behalf of the user (up to their plan limit).\"",
 "definitions.runscope_auth.scopes.[\"team:read\"]: \"Allows you to read team details such as lists of team members and external service integrations.\"",
 "definitions.runscope_auth.scopes.[\"test:read\"]: \"Allows you to read the details of API tests.\"",
 "definitions.runscope_auth.scopes.[\"test:write\"]: \"Allows you to create, update and delete details of API tests.\"",
 "definitions.runscope_auth.tokenUrl: \"https://www.runscope.com/signin/oauth/access_token\"",
 "definitions.runscope_auth.type: \"oauth2\"",
 "host: \"api.runscope.com\"",
 "parameterizedHost: null",
 "perOp: /account get [{\"runscope_auth\":[\"account:email\",\"api:read\"]}]",
 "perOp: /buckets get [{\"runscope_auth\":[\"api:read\",\"bucket:auth_token\"]},{\"runscope_auth\":[\"api:read\"]}]",
 "perOp: /buckets post [{\"runscope_auth\":[\"api:read\",\"bucket:write\"]}]",
 "perOp: /buckets/{bucketKey} delete [{\"runscope_auth\":[\"api:read\",\"bucket:write\"]}]",
 "perOp: /buckets/{bucketKey}/environments get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/environments post [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/environments/{environmentId} put [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/messages delete [{\"runscope_auth\":[\"api:read\",\"message:write\"]}]",
 "perOp: /buckets/{bucketKey}/messages post [{\"runscope_auth\":[\"api:read\",\"message:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/tests post [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId} delete [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId} get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId} put [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/environments get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/environments post [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/environments/{environmentId} put [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/metrics get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/steps get [{\"runscope_auth\":[\"api:read\",\"test:read\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/steps post [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/steps/{stepId} delete [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /buckets/{bucketKey}/tests/{testId}/steps/{stepId} put [{\"runscope_auth\":[\"api:read\",\"test:write\"]}]",
 "perOp: /teams/{teamId}/agents get [{\"runscope_auth\":[\"api:read\",\"team:read\"]}]",
 "perOp: /teams/{teamId}/integrations get [{\"runscope_auth\":[\"api:read\",\"team:read\"]}]",
 "perOp: /teams/{teamId}/people get [{\"runscope_auth\":[\"account:email\",\"api:read\",\"team:read\"]}]",
 "schemes: [\"https\"]",
 "security[]: {\"runscope_auth\":[\"api:read\"]}"
]

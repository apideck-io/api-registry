 "schemes.oauth2.flows.authorizationCode.authorizationUrl: \"https://connect.squareup.com/oauth2/authorize\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ADDON_CONFIGURATIONS_READ: \"__HTTP Method__: `GET`\\n\\nGrants write access for third-party Add-ons to read configurations of their Add-ons, for example, when calling `RetrieveConfiguration` endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ADDON_CONFIGURATIONS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access for third-party Add-ons to store configurations of their Add-ons, for example, when calling `CreateConfiguration` endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.APPOINTMENTS_ALL_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nGrants read access to all of a seller's booking information, calendar, and business details.\\nThis permission must be accompanied by the `APPOINTMENTS_READ` permission.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.APPOINTMENTS_ALL_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to all booking details, including double-booking a seller.\\nThis permission must be accompanied by the `APPOINTMENTS_WRITE` permission.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.APPOINTMENTS_BUSINESS_SETTINGS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to booking business settings. For example, to call the\\nListTeamMemberBookingProfiles endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.APPOINTMENTS_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nGrants read access to booking information. For example, to call the\\nRetrieveBooking endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.APPOINTMENTS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to booking information. For example, to call the CreateBooking endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.BANK_ACCOUNTS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to bank account information associated with the targeted\\nSquare account. For example, to call the Connect v1 ListBankAccounts endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CASH_DRAWER_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to cash drawer shift information. For example, to call the\\nListCashDrawerShifts endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CHANNELS_CREATE: \"__HTTP Method__: `POST`\\n\\nGrants write access to create channels, for example, when calling the\\n`CreateChannel` endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CHANNELS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to view channels, for example, when calling the\\n`RetrieveChannel` endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CHANNELS_UPDATE: \"__HTTP Method__: `PUT`\\n\\nGrants write access to update channels, for example, when calling the\\n`UpdateChannel` endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CUSTOMERS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to customer information. For example, to call the\\nListCustomers endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.CUSTOMERS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to customer information. For example, to create and update\\ncustomer profiles.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DEVICES_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to device information. For example, to\\ncall the `GetDevice` and `ListDevices` endpoints.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DEVICE_CREDENTIAL_MANAGEMENT: \"__HTTP Method__: `POST`, `GET`\\n\\nGrants read/write access to device credentials information. For example, to\\ncall the CreateDeviceCode endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DISCOUNT_CODES_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to Discount Codes API. For example, to call the `RetrieveDiscountCode` and `RetrieveRedemption` endpoints.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DISCOUNT_CODES_WRITE: \"__HTTP Method__: `POST`\\n\\nGrants write access to Discount Codes API.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DISPUTES_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to dispute information. For example, to call the RetrieveDispute\\nendpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.DISPUTES_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to dispute information. For example, to call the SubmitEvidence\\nendpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.EMPLOYEES_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to employee profile information. For example, to call the\\nConnect v1 Employees API.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.EMPLOYEES_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to employee profile information. For example, to create\\nand modify employee profiles.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.GIFTCARDS_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nGrants read access to gift card information. For example, to call the RetrieveGiftCard\\nendpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.GIFTCARDS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to gift card information. For example, to call the CreateGiftCard\\nendpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.INVENTORY_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to inventory information. For example, to call the\\nRetrieveInventoryCount endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.INVENTORY_WRITE: \"__HTTP Method__:  `POST`, `PUT`, `DELETE`\\n\\nGrants write access to inventory information. For example, to call the\\nBatchChangeInventory endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.INVOICES_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nGrants read access to invoice information. For example, to call the ListInvoices endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.INVOICES_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to invoice information. For example, to call the CreateInvoice endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ITEMS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to product catalog information. For example, to obtain objects in a product catalog.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ITEMS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to product catalog information. For example, to modify or\\nadd to a product catalog.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.LOYALTY_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to loyalty information. For example, to call the\\nListLoyaltyPrograms endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.LOYALTY_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to loyalty information. For example, to call the\\nCreateLoyaltyAccount endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.MERCHANT_PROFILE_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to business and location information. For example, to\\nobtain a location ID for subsequent activity.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.MERCHANT_PROFILE_WRITE: \"__HTTP Method__: `POST`, `PUT`\\n\\nGrants write access to business and location information. For example, to create a new location or\\nupdate the business hours at an existing location.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ONLINE_STORE_SITE_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nRead access to ECOM online store site details.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ONLINE_STORE_SNIPPETS_READ: \"__HTTP Method__: `GET`, `POST`\\n\\nRead access to ECOM online store snippets on published websites.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ONLINE_STORE_SNIPPETS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nWrite access to ECOM online store snippets on published websites.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ORDERS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to order information. For example, to call the\\nBatchRetrieveOrders endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.ORDERS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to order information. For example, to call the\\nCreateCheckout endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.PAYMENTS_READ: \"__HTTP Method__: `GET`\\n\\nGrants read access to transaction and refund information. For example, to call\\nthe RetrieveTransaction endpoint.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.PAYMENTS_WRITE: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to transaction and refunds information. For example, to\\nprocess payments with the Payments or Checkout API.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.PAYMENTS_WRITE_ADDITIONAL_RECIPIENTS: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nAllow third party applications to deduct a portion of each transaction amount.\\n__Required__ to use multiparty transaction functionality with the Payments\\nAPI.\"",
 "schemes.oauth2.flows.authorizationCode.scopes.PAYMENTS_WRITE_IN_PERSON: \"__HTTP Method__: `POST`, `PUT`, `DELETE`\\n\\nGrants write access to payments and refunds information. For example, to\\nprocess in-person payments.\"",
